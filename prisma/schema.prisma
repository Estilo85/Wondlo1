datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(uuid())
  firebaseId         String?   @unique
  name               String
  email              String    @unique
  avatarUrl          String?   @db.Text
  freeSearchesUsed   Int       @default(0)
  plan               String    @default("free_trial")
  searchAllowance    Int       @default(3)
  searchAllowanceUsed Int      @default(0)
  cycleEndsAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  searches           Search[]
  savedCards         SavedCard[]
  purchases          Purchase[]
  communityPosts     CommunityPost[]
  communityLikes     CommunityLike[]
  communityComments  CommunityComment[]
  communityReports   CommunityReport[]
  safetyReviews      SafetyReview[]
}

model SavedCard {
  id             String   @id @default(uuid())
  userId         String
  brand          String
  last4          String
  expMonth       Int
  expYear        Int
  isDefault      Boolean  @default(false)
  billingAddress Json?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Purchase {
  id             String   @id @default(uuid())
  userId         String
  plan           String
  amountPence    Int
  currency       String   @default("GBP")
  orderRef       String   @unique
  cardBrand      String?
  cardLast4      String?
  billingAddress Json?
  status         String   @default("paid")
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Search {
  id        String   @id @default(uuid())
  userId    String
  query     String
  queryKey  String
  analysis  Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, queryKey])
  @@index([userId, createdAt])
}

model CommunityPost {
  id        String             @id @default(uuid())
  userId    String
  category  String
  country   String
  activity  String
  title     String
  body      String             @db.Text
  image     String?            @db.Text
  shareCount Int               @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     CommunityLike[]
  comments  CommunityComment[]
  reports   CommunityReport[]

  @@index([createdAt])
  @@index([userId, createdAt])
}

model CommunityLike {
  id        String        @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model CommunityComment {
  id        String             @id @default(uuid())
  postId    String
  userId    String
  text      String             @db.Text
  createdAt DateTime           @default(now())
  post      CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports   CommunityReport[]

  @@index([postId, createdAt])
  @@index([userId])
}

/*
 * One row covers both kinds of report. Exactly one of postId or commentId is
 * set, which the API enforces before writing: a report always points at real
 * content that can be reviewed and removed.
 *
 * Removing reported content nulls the reference instead of deleting the row, so
 * a moderation decision stays on record after the content itself is gone.
 */
model CommunityReport {
  id         String            @id @default(uuid())
  reporterId String
  postId     String?
  commentId  String?
  reason     String
  details    String?           @db.Text
  status     String            @default("open")
  resolution String?
  createdAt  DateTime          @default(now())
  resolvedAt DateTime?
  reporter   User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  post       CommunityPost?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment    CommunityComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([postId])
  @@index([commentId])
}

model SafetyReview {
  id                   String   @id @default(uuid())
  userId               String
  operatorName         String
  country              String
  activity             String
  operatorAssessment   Int
  adventurePreparation Int
  riskAwareness        Int
  safetyQuestions      Int
  realWorldAccuracy    Int
  experience           String   @db.Text
  improvement          String?  @db.Text
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}
